{
  "description": "naturalize for Codex: append a plain-language rewrite of the final assistant message as a systemMessage when a turn stops.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/codex-stop.sh\"",
            "timeout": 620,
            "statusMessage": "naturalize: rewriting in plain language"
          }
        ]
      }
    ]
  }
}
